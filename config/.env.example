# ============================================================
# miyako 环境变量模板 —— setup_env.py 会把本文件复制为仓库根目录的 .env
#
# BYOK（自带钥匙）模式：密钥只存本地 .env，不进 git、不进发布包。
# 全部留空也可以启动（mock 模式不需要任何 key）。
# ============================================================

# LLM（OpenAI 兼容；M2.2 起 provider: api 时使用）
# 变量名与 settings.yaml llm.api.api_key_env 对应（缺省即本名）
OPENAI_API_KEY=
# 备用回落：settings llm.api.base_url 缺省时使用（如本地 Ollama）
OPENAI_BASE_URL=
# 备用回落：settings llm.api.model 缺省时使用
# LLM_MODEL=

# 云端音色克隆 TTS（providers.tts: cloud_clone 时使用；2026-09-12）
# 变量名与 settings providers.tts_cloudclone.api_key_env 对应（缺省即本名）
CLOUD_TTS_API_KEY=

# 预留
# UPDATE_URL=
