data/memory.db*
data/memory/*
!data/memory/.gitkeep
data/server.pid
data/tmp/
data/server.token
config/settings.yaml
.env
__pycache__/

# ---- 角色包游戏版权物料（产线接入 v1.9；不进 git 与发布包）----
data/characters/*/sprites/*.png
data/characters/*/audiofile/
data/characters/*/reference_audio/

# ---- 默认 TTS 权重（2026-09-18 酒馆卡适配；大文件+版权，不进 git）----
data/tts/
data/characters/*/tts/**/*.pth
data/characters/*/tts/**/*.ckpt
data/characters/*/tts/**/*.bin

